# ---------------------------------------------------------------------------
# Backend operacional FACESP Match (fonte de dados das ferramentas MCP)
# ---------------------------------------------------------------------------
IA_MCP_BACKEND_BASE_URL=http://localhost:8000
IA_MCP_BACKEND_TIMEOUT_SECONDS=10
# Ator enviado nas chamadas /api/mcp/* (o backend exige X-Perfil).
IA_MCP_BACKEND_PERFIL=mcp
# Opcional: id do ator (X-Ator-Id).
# IA_MCP_BACKEND_ATOR_ID=

# ---------------------------------------------------------------------------
# Provedor de IA (OpenAI-compatible)
# auto: tenta o modelo e cai no heurístico local em caso de falha.
# heuristic: usa apenas o heurístico local (funciona offline).
# ---------------------------------------------------------------------------
IA_MCP_AI_PROVIDER=auto
IA_MCP_AI_BASE_URL=https://api.openai.com/v1
IA_MCP_AI_API_KEY=
IA_MCP_AI_MODEL=gpt-4o-mini
IA_MCP_AI_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Vocabulário de tags (arquivo JSON fornecido pelo backend operacional)
# ---------------------------------------------------------------------------
IA_MCP_VOCABULARY_PATH=src/ia_mcp/vocabulary/tags.json
IA_MCP_KEYWORDS_PATH=src/ia_mcp/vocabulary/keywords.json

# ---------------------------------------------------------------------------
# Serviço HTTP (FastAPI + FastMCP no mesmo processo)
# ---------------------------------------------------------------------------
IA_MCP_API_HOST=0.0.0.0
IA_MCP_API_PORT=8100
IA_MCP_MCP_PATH=/mcp

# ---------------------------------------------------------------------------
# Limites e observabilidade
# ---------------------------------------------------------------------------
IA_MCP_MAX_TAGS=8
IA_MCP_MIN_TAG_CONFIDENCE=0.35
IA_MCP_MAX_TEXT_CHARS=4000
IA_MCP_MAX_SUMMARY_CHARS=600
IA_MCP_LOG_LEVEL=INFO
IA_MCP_LOG_TEXT=false
