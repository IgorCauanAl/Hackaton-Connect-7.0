# ---------------------------------------------------------------------------
# Backend operacional (demandas, matching, curadoria, testes, relatórios)
# ---------------------------------------------------------------------------
ORQ_BACKEND_BASE_URL=http://localhost:8000
# Deve cobrir a chamada do backend ao IA/MCP (FACESP_IA_TIMEOUT) com folga.
ORQ_BACKEND_TIMEOUT_SECONDS=40

# ---------------------------------------------------------------------------
# Serviço IA/MCP (classificação textual, insights e ferramentas MCP)
# ---------------------------------------------------------------------------
ORQ_IA_BASE_URL=http://localhost:8100
ORQ_IA_TIMEOUT_SECONDS=30
# Endpoint Streamable HTTP do FastMCP montado pelo IA/MCP.
ORQ_MCP_URL=http://localhost:8100/mcp/
ORQ_MCP_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Serviço HTTP do orquestrador
# ---------------------------------------------------------------------------
ORQ_API_HOST=0.0.0.0
ORQ_API_PORT=8200

# ---------------------------------------------------------------------------
# Frontend React (build do Vite servido na mesma origem)
# Quando ORQ_FRONTEND_ENABLED=true e o build existe, o orquestrador serve
# ``/`` e as páginas ``*.html``. Desligue para rodar só a API.
# ---------------------------------------------------------------------------
ORQ_FRONTEND_ENABLED=true
# Padrão: orquestrador/frontend/dist (calculado a partir do pacote).
# ORQ_FRONTEND_DIR=

# ---------------------------------------------------------------------------
# Idempotência e observabilidade
# ---------------------------------------------------------------------------
ORQ_IDEMPOTENCY_TTL_SECONDS=600
ORQ_LOG_LEVEL=INFO
