FACESP_DB_PATH=facesp_demo.db
# URL do serviço de IA/MCP (colega). Vazio = IA indisponível -> backend usa fallbacks.
# Execução integrada (scripts/dev.sh): http://localhost:8100
FACESP_IA_URL=http://localhost:8100
# Precisa cobrir a chamada do backend ao IA/MCP (AI_TIMEOUT do serviço IA).
FACESP_IA_TIMEOUT=25
