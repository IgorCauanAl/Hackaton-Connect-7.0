# ---------------------------------------------------------------------------
# Execução integrada (scripts/dev.sh)
#
# Copie para `.env` na raiz do repositório. O dev.sh carrega este arquivo e
# exporta as variáveis para os três serviços. Nenhuma chave deve ser comitada.
# ---------------------------------------------------------------------------

# ------------------------------------------------------------------ backend
# Banco SQLite da demo (relativo à pasta back-end/ quando usado pelo dev.sh).
FACESP_DB_PATH=facesp_demo.db
# URL do serviço IA/MCP. Vazio desliga a IA; o backend usa fallbacks.
FACESP_IA_URL=http://localhost:8100
FACESP_IA_TIMEOUT=25

# ----------------------------------------------------------------- IA/MCP
# Provedor OpenAI-compatible. Sem chave/modelo, o serviço usa o heurístico
# local (funciona offline). `auto` tenta o modelo e cai no heurístico.
# Os nomes canônicos AI_* e os prefixados IA_MCP_AI_* são aceitos; o prefixado
# tem precedência quando ambos existem.
AI_PROVIDER=auto
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=20

# ------------------------------------------------ IA/MCP (infra e limites)
IA_MCP_BACKEND_BASE_URL=http://localhost:8000
IA_MCP_BACKEND_TIMEOUT_SECONDS=10
IA_MCP_BACKEND_PERFIL=mcp
IA_MCP_API_HOST=0.0.0.0
IA_MCP_API_PORT=8100
IA_MCP_MCP_PATH=/mcp
IA_MCP_LOG_LEVEL=INFO

# -------------------------------------------------------------- orquestrador
ORQ_BACKEND_BASE_URL=http://localhost:8000
ORQ_BACKEND_TIMEOUT_SECONDS=40
ORQ_IA_BASE_URL=http://localhost:8100
ORQ_IA_TIMEOUT_SECONDS=30
ORQ_MCP_URL=http://localhost:8100/mcp/
ORQ_MCP_TIMEOUT_SECONDS=10
ORQ_API_HOST=0.0.0.0
ORQ_API_PORT=8200
ORQ_FRONTEND_ENABLED=true
# Deixe vazio para usar orquestrador/frontend/dist (padrão).
# ORQ_FRONTEND_DIR=
ORQ_IDEMPOTENCY_TTL_SECONDS=600
ORQ_LOG_LEVEL=INFO
